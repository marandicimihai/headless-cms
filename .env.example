# Development-only defaults. Copy this file to .env to override values locally.
# Do not reuse these credentials in a deployed environment.
FRONTEND_PORT=3000
API_PORT=5123
POSTGRES_PORT=55000

POSTGRES_DB=HeadlessCms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Optional. Enables the project schema assistant through Groq.
GROQ_API_KEY=
# Optional load-test overrides. LOAD_TEST_PATH must identify an existing resource.
LOAD_TEST_EMAIL=admin@example.com
LOAD_TEST_PASSWORD=password
LOAD_TEST_PATH=
LOAD_TEST_VUS=10
LOAD_TEST_DURATION=30s
LOAD_TEST_WARMUP_REQUESTS=1
