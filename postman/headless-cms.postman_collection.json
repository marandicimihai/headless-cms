{
  "info": {
    "name": "Headless CMS",
    "_postman_id": "7d447945-3d5a-45d0-b7b8-1b93cf12a190",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7001/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "tenantId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "invitationId", "value": "" },
    { "key": "invitationToken", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Preview invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{invitationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/invitations/preview"
          }
        },
        {
          "name": "Register with invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{invitationToken}}\",\n  \"password\": \"change-me\"\n}"
            },
            "url": "{{baseUrl}}/auth/invitations/register"
          }
        },
        {
          "name": "Accept invitation as existing user",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{invitationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/invitations/accept"
          }
        }
      ]
    },
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Create tenant",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tenant A\",\n  \"ownerEmail\": \"owner@example.com\"\n}"
            },
            "url": "{{baseUrl}}/tenants"
          }
        },
        {
          "name": "List platform tenants",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants?page=1&pageSize=20"
          }
        },
        {
          "name": "Get tenant",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}"
          }
        },
        {
          "name": "Rename tenant",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Renamed tenant\"\n}" },
            "url": "{{baseUrl}}/tenants/{{tenantId}}"
          }
        },
        {
          "name": "My tenants",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/me/tenants"
          }
        },
        {
          "name": "Leave tenant",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/me/tenants/{{tenantId}}"
          }
        }
      ]
    },
    {
      "name": "Invitations",
      "item": [
        {
          "name": "Invite editor/member",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"editor@example.com\",\n  \"role\": \"Editor\"\n}"
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/invitations"
          }
        },
        {
          "name": "List invitations",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/invitations?page=1&pageSize=20"
          }
        },
        {
          "name": "Resend invitation",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/invitations/{{invitationId}}/resend"
          }
        },
        {
          "name": "Revoke invitation",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/invitations/{{invitationId}}"
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/members?page=1&pageSize=20"
          }
        },
        {
          "name": "Change member role",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"Member\"\n}" },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/members/{{userId}}"
          }
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/members/{{userId}}"
          }
        },
        {
          "name": "Transfer ownership",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newOwnerUserId\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/ownership-transfer"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Website\"\n}" },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/projects"
          }
        },
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/projects"
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/projects/{{projectId}}"
          }
        },
        {
          "name": "Rename project",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated website\"\n}" },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/projects/{{projectId}}"
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/tenants/{{tenantId}}/projects/{{projectId}}"
          }
        }
      ]
    }
  ]
}
