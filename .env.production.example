# Copy to .env.production; chmod 600 .env.production.
# Production Compose reads this file; it is never copied into images.
# A hostname only: no scheme, path, or port. DNS must point to the server.
APP_DOMAIN=cms.example.com
RELEASE_TAG=release-001

POSTGRES_DB=headless_cms
POSTGRES_USER=headless_cms
POSTGRES_PASSWORD=
# Set matching credentials below. Use single quotes around values containing $.
# Bundled: Host=postgres;Port=5432;Database=headless_cms;Username=headless_cms;Password=...;Maximum Pool Size=20
DATABASE_CONNECTION_STRING=
ADMIN_EMAIL=
# 15–64 characters; initialization does not rotate an existing password.
ADMIN_PASSWORD=

LOAD_TEST_EMAIL=
LOAD_TEST_PASSWORD=
LOAD_TEST_PATH=
LOAD_TEST_VUS=10
LOAD_TEST_DURATION=30s
LOAD_TEST_WARMUP_REQUESTS=1
LOAD_TEST_MEMORY_LIMIT=512m
LOAD_TEST_CPU_LIMIT=1.0
INITIALIZE_MEMORY_LIMIT=512m
INITIALIZE_CPU_LIMIT=1.0
API_MEMORY_LIMIT=768m
API_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=768m
FRONTEND_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.5
# Change all three together if this subnet conflicts with your network.
PROXY_SUBNET=172.30.20.0/24
PROXY_DYNAMIC_RANGE=172.30.20.128/25
PROXY_ADDRESS=172.30.20.2

# Backup tools use libpq fields, independently of the .NET connection string.
BACKUP_PGHOST=postgres
BACKUP_PGPORT=5432
BACKUP_PGSSLMODE=prefer
