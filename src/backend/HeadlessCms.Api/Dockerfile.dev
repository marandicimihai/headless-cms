FROM mcr.microsoft.com/dotnet/sdk:10.0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY .config/dotnet-tools.json .config/dotnet-tools.json
COPY src/backend/HeadlessCms.Api/HeadlessCms.Api.csproj src/backend/HeadlessCms.Api/HeadlessCms.Api.csproj
RUN dotnet restore src/backend/HeadlessCms.Api/HeadlessCms.Api.csproj \
    && dotnet tool restore

ENV DOTNET_USE_POLLING_FILE_WATCHER=1 \
    DOTNET_WATCH_RESTART_ON_RUDE_EDIT=1 \
    ASPNETCORE_URLS=http://+:8080

EXPOSE 8080

CMD ["dotnet", "watch", "--project", "src/backend/HeadlessCms.Api/HeadlessCms.Api.csproj", "run", "--no-launch-profile"]
